# Optional: copy to .env to preset values before `init`.
# Anything missing is detected from backup/ or asked for interactively.

# Local URL. For a custom domain (e.g. http://mysite.test:8090) add it to your hosts file.
SITE_URL=http://localhost:8090

# Your own themes/plugins to map into src/ (space separated, or "none").
# Leave unset to auto-detect (folders without a wordpress.org readme.txt).
#SRC_THEMES=my-theme
#SRC_PLUGINS=my-plugin another-plugin

# WordPress + PHP version (Docker image tag, see https://hub.docker.com/_/wordpress)
#WORDPRESS_TAG=php8.3-apache

# Plugins deactivated locally (only if installed and active)
#DEV_DISABLE_PLUGINS=wps-hide-login google-site-kit wordfence really-simple-ssl wp-rocket

# Local admin user (created, or password reset if it already exists)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@local.test

MAILPIT_PORT=8025

# Detected automatically from backup/ (no need to fill in)
#BACKUP_ZIP=
#BACKUP_SQL=
#PROD_URL=
#TABLE_PREFIX=
#WORDPRESS_PORT=
